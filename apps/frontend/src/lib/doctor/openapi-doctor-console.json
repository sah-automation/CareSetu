{
  "schemas": {
    "CaseWorkspaceLink": {
      "properties": {
        "case_id": {
          "type": "integer"
        },
        "stage": {
          "type": "string"
        }
      },
      "required": ["case_id", "stage"],
      "type": "object"
    },
    "ConsentEventView": {
      "properties": {
        "actor_patient_id": {
          "type": "integer"
        },
        "kind": {
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "type": "string"
        },
        "version": {
          "type": "integer"
        }
      },
      "required": ["kind", "version", "actor_patient_id", "occurred_at"],
      "type": "object"
    },
    "ConsentView": {
      "properties": {
        "consent_id": {
          "type": "integer"
        },
        "counterparty_display_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "counterparty_id": {
          "type": "string"
        },
        "counterparty_type": {
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "events": {
          "items": {
            "$ref": "#/components/schemas/ConsentEventView"
          },
          "type": "array"
        },
        "lineage_ref": {
          "type": "string"
        },
        "patient_id": {
          "type": "integer"
        },
        "record_scope": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "type": "string"
        },
        "version": {
          "type": "integer"
        }
      },
      "required": [
        "consent_id",
        "lineage_ref",
        "patient_id",
        "counterparty_type",
        "counterparty_id",
        "record_scope",
        "status",
        "version",
        "created_at",
        "updated_at",
        "events"
      ],
      "type": "object"
    },
    "ContactSection": {
      "properties": {
        "age": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "area": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "emergency_contact": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "gender": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "has_photo": {
          "default": false,
          "type": "boolean"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "DoctorCaseRow": {
      "properties": {
        "case_id": {
          "type": "integer"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "forced_review": {
          "default": false,
          "type": "boolean"
        },
        "has_photo": {
          "default": false,
          "type": "boolean"
        },
        "patient_age": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "patient_id": {
          "type": "integer"
        },
        "patient_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "stage": {
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "stage",
        "created_at",
        "updated_at",
        "patient_id"
      ],
      "type": "object"
    },
    "DoctorCasesListView": {
      "properties": {
        "items": {
          "items": {
            "$ref": "#/components/schemas/DoctorCaseRow"
          },
          "type": "array"
        }
      },
      "required": ["items"],
      "type": "object"
    },
    "DoctorPatientDetailView": {
      "properties": {
        "bucket": {
          "enum": ["current", "past"],
          "type": "string"
        },
        "case_workspace": {
          "anyOf": [
            {
              "$ref": "#/components/schemas/CaseWorkspaceLink"
            },
            {
              "type": "null"
            }
          ]
        },
        "consultation_history": {
          "anyOf": [
            {
              "$ref": "#/components/schemas/RecordTimeline"
            },
            {
              "type": "null"
            }
          ]
        },
        "contact": {
          "anyOf": [
            {
              "$ref": "#/components/schemas/ContactSection"
            },
            {
              "type": "null"
            }
          ]
        },
        "granted_scopes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "health_background": {
          "anyOf": [
            {
              "$ref": "#/components/schemas/HealthBackgroundView"
            },
            {
              "type": "null"
            }
          ]
        },
        "latest_case_stage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "patient_id": {
          "type": "integer"
        }
      },
      "required": ["patient_id", "bucket"],
      "type": "object"
    },
    "DoctorPatientRow": {
      "properties": {
        "age": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "bucket": {
          "enum": ["current", "past"],
          "type": "string"
        },
        "granted_scopes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "has_photo": {
          "default": false,
          "type": "boolean"
        },
        "latest_case_stage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "patient_id": {
          "type": "integer"
        }
      },
      "required": ["patient_id", "bucket"],
      "type": "object"
    },
    "EgressLogEntry": {
      "properties": {
        "consent_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "counterparty_display_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "counterparty_id": {
          "type": "string"
        },
        "counterparty_type": {
          "type": "string"
        },
        "disclosed_at": {
          "format": "date-time",
          "type": "string"
        },
        "disclosed_entry_ids": {
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "egress_id": {
          "type": "integer"
        },
        "lineage_ref": {
          "type": "string"
        },
        "patient_id": {
          "type": "integer"
        },
        "record_scope": {
          "type": "string"
        },
        "version": {
          "type": "integer"
        }
      },
      "required": [
        "egress_id",
        "patient_id",
        "consent_id",
        "lineage_ref",
        "version",
        "counterparty_type",
        "counterparty_id",
        "record_scope",
        "disclosed_entry_ids",
        "disclosed_at"
      ],
      "type": "object"
    },
    "HealthBackground": {
      "additionalProperties": false,
      "properties": {
        "allergies": {
          "items": {
            "maxLength": 200,
            "type": "string"
          },
          "maxItems": 50,
          "type": "array"
        },
        "blood_group": {
          "anyOf": [
            {
              "maxLength": 16,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "conditions": {
          "items": {
            "maxLength": 200,
            "type": "string"
          },
          "maxItems": 50,
          "type": "array"
        },
        "family_history": {
          "items": {
            "maxLength": 200,
            "type": "string"
          },
          "maxItems": 50,
          "type": "array"
        },
        "immunizations": {
          "items": {
            "maxLength": 200,
            "type": "string"
          },
          "maxItems": 50,
          "type": "array"
        },
        "medications": {
          "items": {
            "maxLength": 200,
            "type": "string"
          },
          "maxItems": 50,
          "type": "array"
        }
      },
      "type": "object"
    },
    "HealthBackgroundView": {
      "properties": {
        "acknowledged": {
          "type": "boolean"
        },
        "background": {
          "anyOf": [
            {
              "$ref": "#/components/schemas/HealthBackground"
            },
            {
              "type": "null"
            }
          ]
        },
        "set": {
          "type": "boolean"
        }
      },
      "required": ["set", "acknowledged"],
      "type": "object"
    },
    "PatientsListView": {
      "properties": {
        "items": {
          "items": {
            "$ref": "#/components/schemas/DoctorPatientRow"
          },
          "type": "array"
        },
        "total": {
          "type": "integer"
        }
      },
      "required": ["items", "total"],
      "type": "object"
    },
    "RecordEntryView": {
      "properties": {
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "entry_id": {
          "type": "integer"
        },
        "entry_type": {
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "required": [
        "entry_id",
        "entry_type",
        "payload",
        "occurred_at",
        "created_at"
      ],
      "type": "object"
    },
    "RecordTimeline": {
      "properties": {
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "entries": {
          "items": {
            "$ref": "#/components/schemas/RecordEntryView"
          },
          "type": "array"
        },
        "patient_id": {
          "type": "integer"
        },
        "record_id": {
          "type": "integer"
        }
      },
      "required": ["record_id", "patient_id", "created_at", "entries"],
      "type": "object"
    }
