{
  "name": "caresetu",
  "private": true,
  "version": "0.1.0",
  "description": "CareSetu — zero-inventory care-loop aggregator monorepo",
  "workspaces": [
    "apps/frontend"
  ],
  "scripts": {
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "npm run test:unit:backend && npm run test:unit:frontend",
    "test:unit:backend": "node scripts/py.cjs -m pytest -c apps/backend/pyproject.toml tests/unit -q",
    "test:unit:frontend": "npm run test -w @caresetu/frontend",
    "test:integration": "node scripts/py.cjs -m pytest -c apps/backend/pyproject.toml tests/integration -q",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "pre-commit run --all-files",
    "lint:backend": "ruff check --config apps/backend/pyproject.toml apps/backend tests",
    "lint:frontend": "npm run lint -w @caresetu/frontend",
    "typecheck": "npm run typecheck:backend && npm run typecheck:frontend",
    "typecheck:backend": "node scripts/py.cjs -m mypy --config-file apps/backend/pyproject.toml apps/backend",
    "typecheck:frontend": "npm run typecheck -w @caresetu/frontend",
    "scan": "npm run scan:secrets:full && npm run scan:backend && npm run scan:audit",
    "scan:secrets": "gitleaks detect --source . --redact --log-opts=HEAD~1..HEAD",
    "scan:secrets:full": "gitleaks detect --source . --redact",
    "scan:backend": "bandit -c apps/backend/pyproject.toml -r apps/backend -q",
    "scan:audit": "pip-audit --path D:/Dev/venvs/backend-env",
    "scan:audit:npm": "npm audit --audit-level=high",
    "migration-check": "node scripts/migration-check.cjs",
    "check:boundaries": "node scripts/py.cjs apps/backend/scripts/check_module_boundaries.py",
    "check:edge": "node scripts/py.cjs apps/backend/scripts/check_edge_config.py",
    "check:backup": "node scripts/py.cjs apps/backend/scripts/check_backup_config.py"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0"
  }
}
