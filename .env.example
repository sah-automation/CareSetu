# CareSetu local development defaults - non-secret values only.
# Copy to .env and override with real values locally; never commit .env.
DATABASE_URL=postgresql+asyncpg://caresetu:caresetu@localhost:5432/caresetu
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=caresetu
MINIO_SECRET_KEY=caresetu-minio-dev
# EXT-001 SMS/OTP: mock is the local/CI default. SMS_PROVIDER=provider with a
# real SMS_API_KEY is staging/production only - Settings refuses it in dev/test.
SMS_PROVIDER=mock
SMS_API_KEY=caresetu-sms-dev
SMS_BASE_URL=https://sms.invalid
SMS_TIMEOUT_SECONDS=10
SMS_MAX_RETRIES=3
# Gateway (PHASE-2 T8, #59): real JWT verification + auth-surface rate limit.
# Both default to disabled; enabling GATEWAY_JWT_VERIFY_ENABLED requires a
# GATEWAY_JWT_SIGNING_KEY (fail-closed boot). GATEWAY_JWT_SIGNING_KEY is a
# secret - set it in the deployment environment, never in a committed .env.
# GATEWAY_JWT_VERIFY_ENABLED=true
# GATEWAY_RATE_LIMIT_ENABLED=true
# GATEWAY_RATE_LIMIT_AUTH_MAX_REQUESTS=10
# GATEWAY_RATE_LIMIT_AUTH_WINDOW_SECONDS=60
# Demo deployment gates (DEPLOY-1 #119; render.yaml sets these in production).
# DEMO_MODE=true is fail-closed: it requires SMS_PROVIDER=mock.
# CORS_ALLOWED_ORIGINS must be the exact frontend origin(s) (CSV, no trailing
# slashes) - wildcard is incompatible with credentialed calls (ADR-0007).
# DEMO_MODE=true
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
# Rejected-partner re-submission throttle (PHASE-5 T09, #253): max rounds a
# rejected partner may open before the operator queue is protected, and the
# cooldown (days) after which the budget refreshes.
PARTNER_RE_SUBMISSION_MAX=3
PARTNER_RE_SUBMISSION_COOLDOWN_DAYS=30
# Daily credential-expiry sweep cadence (PHASE-6 T04a, #315): the worker's
# periodic job runs the ADR-0011 close-out pass on this 5-field crontab (UTC).
# Default "30 1 * * *" = 01:30 UTC daily.
PARTNER_CREDENTIAL_SWEEP_CRON=30 1 * * *
# Public directory search (MOD-002, PHASE-6): DIRECTORY_MAX_RESULTS is the
# configuration-driven cap applied after distance ordering, so a search result
# list tops out at the meaningful top-N nearest matches (default 50);
# REDIS_DIRECTORY_TTL_SECONDS sets how long each search result is served from
# the optional Redis accelerator before recomputing SQL (default 300).
DIRECTORY_MAX_RESULTS=50
REDIS_DIRECTORY_TTL_SECONDS=300

# Frontend build-time config (Vercel project env, not backend .env). Required on
# Vercel - next.config.ts fails the production build without it (ADR-0007 rule 11).
# NEXT_PUBLIC_API_BASE_URL=https://your-api.onrender.com
# Phone normalization country code (no leading +) - used by normalizePhone in the
# registration wizard. Default "91" (India). Override for other launch geographies.
# NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=91
# Geolocation fallback coordinates (decimal degrees) used when the browser
# Geolocation API is unavailable or permission is denied. Defaults to Daltonganj
# (launch scope). Override for other regions.
# NEXT_PUBLIC_DEFAULT_LATITUDE=24.04
# NEXT_PUBLIC_DEFAULT_LONGITUDE=84.07
# Partner-status poll interval (ms) used by pending/rejected screens while the
# application is in a transitional state. Default 10000 (10 s).
# NEXT_PUBLIC_STATUS_POLL_INTERVAL_MS=10000
