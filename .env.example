# CareSetu local development defaults - non-secret values only.
# Copy to .env and override with real values locally; never commit .env.
DATABASE_URL=postgresql+asyncpg://caresetu:caresetu@localhost:5432/caresetu
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=caresetu
MINIO_SECRET_KEY=caresetu-minio-dev
# EXT-001 SMS/OTP: mock is the local/CI default. SMS_PROVIDER=provider with a
# real SMS_API_KEY is staging/production only - Settings refuses it in dev/test.
SMS_PROVIDER=mock
SMS_API_KEY=caresetu-sms-dev
SMS_BASE_URL=https://sms.invalid
SMS_TIMEOUT_SECONDS=10
SMS_MAX_RETRIES=3
# Gateway (PHASE-2 T8, #59): real JWT verification + auth-surface rate limit.
# Both default to disabled; enabling GATEWAY_JWT_VERIFY_ENABLED requires a
# GATEWAY_JWT_SIGNING_KEY (fail-closed boot). GATEWAY_JWT_SIGNING_KEY is a
# secret - set it in the deployment environment, never in a committed .env.
# GATEWAY_JWT_VERIFY_ENABLED=true
# GATEWAY_RATE_LIMIT_ENABLED=true
# GATEWAY_RATE_LIMIT_AUTH_MAX_REQUESTS=10
# GATEWAY_RATE_LIMIT_AUTH_WINDOW_SECONDS=60
# Demo deployment gates (DEPLOY-1 #119; render.yaml sets these in production).
# DEMO_MODE=true is fail-closed: it requires SMS_PROVIDER=mock, and a real AI
# provider (AI_PROVIDER=openai_compatible) under demo mode additionally needs
# AI_ALLOW_DEMO_PROVIDER=true (T14, #414).
# CORS_ALLOWED_ORIGINS must be the exact frontend origin(s) (CSV, no trailing
# slashes) - wildcard is incompatible with credentialed calls (ADR-0007).
# DEMO_MODE=true
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
# Rejected-partner re-submission throttle (PHASE-5 T09, #253): max rounds a
# rejected partner may open before the operator queue is protected, and the
# cooldown (days) after which the budget refreshes.
PARTNER_RE_SUBMISSION_MAX=3
PARTNER_RE_SUBMISSION_COOLDOWN_DAYS=30
# Daily credential-expiry sweep cadence (PHASE-6 T04a, #315): the worker's
# periodic job runs the ADR-0011 close-out pass on this 5-field crontab (UTC).
# Default "30 1 * * *" = 01:30 UTC daily.
PARTNER_CREDENTIAL_SWEEP_CRON=30 1 * * *
# Public directory search (MOD-002, PHASE-6): DIRECTORY_MAX_RESULTS is the
# configuration-driven cap applied after distance ordering, so a search result
# list tops out at the meaningful top-N nearest matches (default 50);
# REDIS_DIRECTORY_TTL_SECONDS sets how long each search result is served from
# the optional Redis accelerator before recomputing SQL (default 300).
DIRECTORY_MAX_RESULTS=50
REDIS_DIRECTORY_TTL_SECONDS=300
# Langfuse AI observability (plan-phase7-tracing-prep): LLM call tracing, cost
# metering, and quality evaluation. Both keys must be set together or both left
# empty (empty = tracing disabled, the app boots normally). LANGFUSE_HOST
# defaults to the US-region cloud endpoint; override for a self-hosted instance.
#LANGFUSE_PUBLIC_KEY="pk-lf-..."
#LANGFUSE_SECRET_KEY="sk-lf-..."
#LANGFUSE_HOST="https://us.cloud.langfuse.com"
#LANGFUSE_TIMEOUT_SECONDS=30.0

# Observability gates (PHASE-14A A5, #693; plan-phase14 §4): all additive and
# disabled by default, so local dev / tests / CI run exactly as before until a
# gate is set. Nothing consumes them yet - later batch tickets A1 (structlog),
# A2 (trace propagation), A3 (OTel), A4 (Sentry) and the MOD-013 consumer read
# these fields.
#
# LOG_FORMAT selects the structured-log renderer (A1): "console" for readable
# dev output, "json" for production log search. Default "console".
LOG_FORMAT=console
# Sentry error tracking (A4): empty = off. Set a real SENTRY_DSN in the deploy
# dashboard - never commit one.
#SENTRY_DSN=""
# Sentry traces sample rate (0..1). Meaningful only with a SENTRY_DSN: a rate
# above the 0 default is refused when the DSN is empty (fail-closed). Default 0.
#SENTRY_TRACES_SAMPLE_RATE=0.0
# OpenTelemetry (A3): OTEL_ENABLED on wires the SDK + HTTP OTLP exporter and
# requires OTEL_EXPORTER_OTLP_ENDPOINT (fail-closed). Headers (e.g.
# "Authorization=Basic ...") are comma-separated key=value pairs and a secret -
# set in the dashboard, never committed. Default 1.0 sampler ratio samples all
# traces; lower it to bound free-tier volume. OTEL_SERVICE_VERSION carries the
# release (git SHA) into resource attributes (shared by A3 and A4).
#OTEL_ENABLED=false
#OTEL_EXPORTER_OTLP_ENDPOINT=""
#OTEL_EXPORTER_OTLP_HEADERS=""
#OTEL_TRACES_SAMPLER_RATIO=1.0
#OTEL_SERVICE_VERSION=""
# Browsable Grafana base URL (PHASE-14A C1b, #707) - the stack the OTLP endpoint
# above exports into, as an operator can actually open it. Serves the operator
# observability "/deeplinks" read; empty (the default) answers with no Grafana
# link at all, never an error. The Sentry and Langfuse links are derived from
# SENTRY_DSN / LANGFUSE_HOST + LANGFUSE_PUBLIC_KEY above.
#GRAFANA_URL="https://caresetu.grafana.net"
# Optional Prometheus /metrics surface (A3) and the MOD-013 Postgres aggregate
# consumer (B-tickets): both off by default.
#METRICS_ENABLED=false
#OBSERVABILITY_ENABLED=false
# Ceiling on the UTC days one nightly observability rollup invocation may cover
# (PHASE-14A B5b, #705). A first-run backfill of a long history, or a catch-up
# after an outage, is trimmed to the OLDEST N days and the remainder is rolled by
# the next invocation - nothing is skipped, no single pass is unbounded.
#OBSERVABILITY_ROLLUP_MAX_DATES=90
# Gateway error capture (PHASE-14A B8, #726; gated #753). ERROR_CAPTURE_ENABLED
# arms the seam itself: false (the default) means no server error is captured at
# all, so the buffer and the drain below have nothing to write and the deployment
# runs exactly as if the feature did not exist. The catch-all seam appends each
# server error to a bounded in-process buffer; a worker job drains the buffer into
# the observability schema every ERROR_DRAIN_INTERVAL_SECONDS. Past the ceiling the
# buffer DISCARDS its oldest record rather than growing - an unbounded buffer turns
# an error storm into an out-of-memory kill. The buffer is per-process, so the drain
# only has records to write in a process that also serves requests (production runs
# the dispatcher in-process in the web service).
#ERROR_CAPTURE_ENABLED=false
#ERROR_CAPTURE_MAX_RECORDS=1000
#ERROR_DRAIN_INTERVAL_SECONDS=30

# Per-minute HTTP counter (PHASE-14A B9, #727). HTTP_COUNTER_ENABLED arms the
# counter itself: false (the default) means no request is counted at all - the
# gateway middleware is not installed and the fold job below has nothing to write -
# so the deployment runs exactly as if the feature did not exist. The gateway counts
# every answered request into a (minute, route template, method, status class) bucket
# in process; a worker job folds those buckets into observability_http_minute, one row
# per route per MINUTE - never one write per request - which is what makes throughput
# and error rate queryable from Postgres past the vendor's 14-day retention.
# HTTP_COUNTER_MAX_SERIES is the ceiling on DISTINCT buckets awaiting a fold, not on
# requests: a thousand requests to one route in one minute are ONE bucket. Past the
# ceiling the OLDEST MINUTE is discarded and counted - a partial minute would report
# a count that silently disagrees with reality, so the whole minute goes.
# HTTP_COUNTER_DRAIN_INTERVAL_SECONDS matches the counter's own one-minute grain,
# which is what bounds the write cost at one row per route per minute. As with the
# error buffer, the buckets are per-process, so the fold only has work to do in a
# process that also serves requests (production runs the dispatcher in-process).
#HTTP_COUNTER_ENABLED=false
#HTTP_COUNTER_MAX_SERIES=5000
#HTTP_COUNTER_DRAIN_INTERVAL_SECONDS=60

# Batch-3 observability feature gates (#753): additive and disabled by default,
# flip one on to opt in (ERROR_CAPTURE_ENABLED lives with its #726 block above).
# EVALUATION_ENABLED runs the #751 deterministic code-evaluator batch as part of
# the daily Langfuse pull; off, the pull still lands the day's metrics and only
# the scores are skipped (observability-rollup.yml opts the scheduled step in).
# ANNOTATION_QUEUE_ENABLED feeds the #752 doctor-review annotation queue from
# review-outcome events; off, the approval keeps its funnel-step effect and only
# the queue write (and the rejection's seat) is skipped.
#EVALUATION_ENABLED=false
#ANNOTATION_QUEUE_ENABLED=false

# MOD-013's alert thresholds (Batch 3, #717; plan-phase14 §11): the limits the
# nightly rollup compares against. Each one is configuration (coding-standards
# §9.1), so a deployment moves a threshold here rather than in code.
# OBSERVABILITY_BUDGET_ALERT_THRESHOLD_PCT is the share of the monthly cap that
# raises ai_budget; OBSERVABILITY_QUEUE_AGE_THRESHOLD_SECONDS is how old the
# oldest still-open job may get; OBSERVABILITY_OUTBOX_BACKLOG_THRESHOLD is the
# parked-row count that raises outbox_backlog;
# OBSERVABILITY_BREAKER_OPEN_SUCCESS_RATE is the success rate below which a
# provider is recorded as broken; OBSERVABILITY_PROVIDER_HEALTH_DROP_THRESHOLD
# is how far the rate may fall before provider_health_drop fires;
# OBSERVABILITY_COST_OUTLIER_MULTIPLE is how many times an actor's own trailing
# average one day of its spend may reach (ADR-0027 D8 asks for a CONFIGURED
# multiple); OBSERVABILITY_COST_OUTLIER_MIN_BASELINE_DAYS is how many of the
# seven baseline days the actor must have spent on;
# OBSERVABILITY_PROVIDER_RATE_LIMIT_ALERT_COUNT is how many upstream refusals
# raise provider_rate_limited.
# The four thresholds NOT here are the ones a decision record pins (ADR-0027
# D8, ADR-0030 D1 and D3): a promised objective is not a knob.
#OBSERVABILITY_BUDGET_ALERT_THRESHOLD_PCT=80
#OBSERVABILITY_BREAKER_OPEN_SUCCESS_RATE=0.5
#OBSERVABILITY_PROVIDER_HEALTH_DROP_THRESHOLD=0.2
#OBSERVABILITY_OUTBOX_BACKLOG_THRESHOLD=500
#OBSERVABILITY_QUEUE_AGE_THRESHOLD_SECONDS=900
#OBSERVABILITY_COST_OUTLIER_MULTIPLE=3
#OBSERVABILITY_COST_OUTLIER_MIN_BASELINE_DAYS=3
#OBSERVABILITY_PROVIDER_RATE_LIMIT_ALERT_COUNT=1

# Security detector (PHASE-14B Batch 2, #779): a five-minute worker scan over
# observability_security_signals. SECURITY_DETECTION_ENABLED=false (the default)
# registers no scan job. The window bounds how much signal history one pass
# counts; the cooldown suppresses a new alert of the same kind after one was
# raised; each threshold is the count within the window that raises the alert.
# Threshold-based kinds auto-resolve when their window falls back below the
# limit. Lockout, consent-revocation and webhook-signature-failure alerts are
# single irreversible incidents and never auto-resolve.
#SECURITY_DETECTION_ENABLED=false
#SECURITY_DETECTOR_WINDOW_MINUTES=15
#SECURITY_DETECTOR_COOLDOWN_SECONDS=1800
#SECURITY_DETECTOR_AUTH_FAILURE_THRESHOLD=20
#SECURITY_DETECTOR_OPERATOR_MFA_FAILURE_THRESHOLD=5
#SECURITY_DETECTOR_RECORD_DENIAL_THRESHOLD=10
#SECURITY_DETECTOR_RATE_LIMIT_THRESHOLD=50
#SECURITY_DETECTOR_PROMPT_INJECTION_THRESHOLD=10

# Prompt-injection heuristics (PHASE-14B Batch 2, #780): screen the intake
# transcript immediately before the structuring egress. PROMPT_INJECTION_HEURISTICS_ENABLED=false
# (the default) runs no screen. When on, a finding emits categories and a score
# only (never patient text) and is advisory - it never blocks the pipeline.
#PROMPT_INJECTION_HEURISTICS_ENABLED=false

# Alert delivery (PHASE-14B Batch 2, #784): durable delivery of alerts via
# Slack/email with retries and redelivery. ALERT_DELIVERY_ENABLED=false (the default)
# registers no router/drainer jobs. When enabled, requires SLACK_WEBHOOK_URL and/or
# SMTP_* settings for the channels to actually deliver.
#ALERT_DELIVERY_ENABLED=false
# SLACK_WEBHOOK_URL is a secret - set in deployment environment, never committed.
#SLACK_WEBHOOK_URL=""
# SMTP settings for email delivery (secrets - set in deployment environment).
#SMTP_HOST=""
#SMTP_PORT=587
#SMTP_USERNAME=""
#SMTP_PASSWORD=""
#SMTP_FROM=""
#SMTP_TO=""
#SMTP_USE_TLS=true

# AI provider gateway (MOD-005 / phase7-intake, #376/#381): controls which LLM backend
# is used for clinical text structuring.  "mock" returns canned responses (default,
# safe for dev/test/CI); "openai_compatible" requires AI_API_KEY, AI_BASE_URL and
# AI_MODEL.  Dev override AI_ALLOW_DEV_PROVIDER=true permits a real provider in
# dev/test; demo_mode forces mock unless AI_ALLOW_DEMO_PROVIDER=true opts in (T14, #414).
AI_PROVIDER="mock"
AI_MODEL=""
# ASR model for the /audio/transcriptions leg (#387): transcription is decoupled
# from structuring. Default is the freemium Groq whisper tier; override freely,
# e.g. whisper-large-v3 for OpenAI.
AI_ASR_MODEL="whisper-large-v3-turbo"
#AI_ALLOW_DEV_PROVIDER=false
# Opt-in allowing a real OpenAI-compatible provider under demo_mode (T14, #414).
# Fail-closed default false; ignored when DEMO_MODE is false. The deployed demo
# sets this true so the live site serves real AI pre-summaries, not mock text.
#AI_ALLOW_DEMO_PROVIDER=false
#AI_API_KEY=""
#AI_BASE_URL=""
#AI_TIMEOUT_SECONDS=30.0
#AI_MAX_RETRIES=3
#AI_CIRCUIT_BREAKER_THRESHOLD=5
#AI_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30.0
#AI_MONTHLY_BUDGET_PAISE=200000
# The monthly AI budget in paise is read by BOTH the runtime BudgetMeter and the
# nightly rollup's ai_budget alert threshold (PHASE-14A B5b, #705). The scheduled
# workflow runs outside this service and takes the same number from the repo
# VARIABLE AI_MONTHLY_BUDGET_PAISE (deployment plan 6.2), so deploy both with the
# same value - otherwise the nightly alert compares against a different cap than
# the meter reports.
# Per-model AI pricing (B1, #699): comma-separated "model:price_in:price_out"
# rates in paise per token. The meter prices a completed AI call off this table
# (input_tokens*price_in + output_tokens*price_out, half-up to the nearest paise).
# A model with no entry is UNKNOWN - it prices 0 and is logged, so a missing rate
# is visible. The default marks the free mock as a known-free (0) model.
#AI_PRICING_TABLE="mock-model:0:0"
#
# Fallback provider (all-or-none: if any AI_FALLBACK_* is set, all four are required).
# The secondary engages only on genuine outages (network / timeout / 429 / 5xx after
# retry budget); a contract rejection (4xx, malformed response) propagates immediately.
# Only "openai_compatible" is accepted as a fallback provider value today.
#AI_FALLBACK_PROVIDER=""
#AI_FALLBACK_BASE_URL=""
#AI_FALLBACK_API_KEY=""
#AI_FALLBACK_MODEL=""
#
# Quick-switch table (all via the OpenAI-compatible chat-completions endpoint):
#
#   Provider        AI_BASE_URL                                  AI_MODEL                      Notes
#   --------------- -------------------------------------------- ----------------------------- ----------------------------
#   Groq            https://api.groq.com/openai/v1               llama-3.3-70b-versatile        Free tier, fast inference
#   Google Gemini   https://generativelanguage.googleapis.com/v1  gemini-2.0-flash               Free tier via OpenAI-compatible
#   OpenRouter      https://openrouter.ai/api/v1                 meta-llama/llama-4-maverick     Varies by model
#   OpenAI          https://api.openai.com/v1                     gpt-4o-mini                     Paid

# Intake media store (MOD-006 / phase7-intake, #376): encrypted intake
# audio/video attachments. INTAKE_MEDIA_KEY is a base64-encoded 32-byte
# AES-256 key (empty = ephemeral dev/test key). INTAKE_MEDIA_BACKEND selects
# the durable backing (phase-7 fix #385):
#
#   Backend     INTAKE_MEDIA_BACKEND   Extra env required
#   ----------- ---------------------- ------------------------------------------------
#   Local disk  local (default)        None - ciphertext under var/intake-media
# Supabase    supabase               SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY
#
# Production (Render free) must use `supabase` - the free disk is ephemeral and
# wipes captured audio on every redeploy; Supabase only ever sees the ciphertext.
#INTAKE_MEDIA_ROOT="var/intake-media"
#INTAKE_MEDIA_KEY=""
#INTAKE_MEDIA_BACKEND="local"
#SUPABASE_URL=""
#SUPABASE_SERVICE_ROLE_KEY=""

# Profile-media store (profiles batch #529, ADR-0020, #532): encrypted patient/
# doctor profile photos (PII - never public). PROFILE_MEDIA_KEY is a base64-
# encoded 32-byte AES-256 key (empty = ephemeral dev/test key).
# PROFILE_MEDIA_BACKEND selects the durable backing, same pattern as intake:
#
#   Backend     PROFILE_MEDIA_BACKEND   Extra env required
#   ----------- ----------------------- ------------------------------------------------
#   Local disk  local (default)         None - ciphertext under var/profile-media
#   Supabase    supabase                SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY
#
# Production (Render free) must use `supabase` in the private profile-media
# bucket - photos survive the ephemeral disk and Supabase only ever sees the
# ciphertext (service-role writes only, no public-read policies).
PROFILE_MEDIA_ROOT="var/profile-media"
# Dev/CI only as empty. A deployed service MUST set this to a stable base64
# 32-byte value (openssl rand -base64 32, kept in the dashboard): an empty key
# makes the store derive an ephemeral per-process key, so every restart silently
# leaves already-stored photos permanently undecryptable.
PROFILE_MEDIA_KEY=""
PROFILE_MEDIA_BACKEND="local"
PROFILE_MEDIA_MAX_ATTEMPTS=3
PROFILE_MEDIA_BACKOFF_SECONDS=0.5
PROFILE_MEDIA_JITTER_FRACTION=0.25
PROFILE_MEDIA_CIRCUIT_BREAKER_THRESHOLD=5
PROFILE_MEDIA_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30.0
PROFILE_MEDIA_TIMEOUT_SECONDS=30.0
PROFILE_MEDIA_MAX_UPLOAD_BYTES=5242880

# In-process dispatcher (async outbox poll loop, intake pipeline,
# credential-expiry sweep). Render free covers web services only (background
# workers need a paid instance), so the production web service hosts the single
# poll loop with this flag ON. Default OFF keeps localhost dev/CI on the
# standalone worker (`python -m worker.main`) - exactly one poll loop across the
# deployment, never both (worker-outbox-runbook Rule 1).
#DISPATCHER_IN_PROCESS_ENABLED=false

# Operator effective-settings cache TTL (seconds). The admin read at
# /v1/operator/settings/effective resolves overrides then env then defaults and
# caches the result in-process for this many seconds. Must be a positive integer.
#SETTINGS_CACHE_TTL_SECONDS=30

# Operator TOTP lockout (PHASE-14B T17, #778). Consecutive wrong codes before
# login locks, and how long the lock lasts in seconds.
#IAM_OPERATOR_MFA_LOCKOUT_THRESHOLD=5
#IAM_OPERATOR_MFA_LOCKOUT_SECONDS=900

# Frontend build-time config (Vercel project env, not backend .env). Required on
# Vercel - next.config.ts fails the production build without it (ADR-0007 rule 11).
# NEXT_PUBLIC_API_BASE_URL=https://your-api.onrender.com
# Phone normalization country code (no leading +) - used by normalizePhone in the
# registration wizard. Default "91" (India). Override for other launch geographies.
# NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=91
# Geolocation fallback coordinates (decimal degrees) used when the browser
# Geolocation API is unavailable or permission is denied. Defaults to Daltonganj
# (launch scope). Override for other regions.
# NEXT_PUBLIC_DEFAULT_LATITUDE=24.04
# NEXT_PUBLIC_DEFAULT_LONGITUDE=84.07
# Partner-status poll interval (ms) used by pending/rejected screens while the
# application is in a transitional state. Default 10000 (10 s).
# NEXT_PUBLIC_STATUS_POLL_INTERVAL_MS=10000
